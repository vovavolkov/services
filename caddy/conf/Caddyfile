# PUBLIC site
vovavolkov.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_delay 2m
		resolvers 1.1.1.1
	}

	root * /srv/vovavolkov
	file_server

	handle_path /files/* {
		root * /srv/vovavolkov/files
		file_server browse
	}

	handle /blog/* {
		root * /srv/vovavolkov
		file_server
	}
}

share.vovavolkov.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_delay 2m
		resolvers 1.1.1.1
	}

	reverse_proxy 127.0.0.1:3000
}
# PRIVATE services (only Tailnet)
*.vovavolkov.com {
	bind 100.79.21.111

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_delay 2m
		resolvers 1.1.1.1
	}

	@adguard host adguard.vovavolkov.com
	handle @adguard {
		reverse_proxy 127.0.0.1:15000
	}

	@paperless host paperless.vovavolkov.com
	handle @paperless {
		reverse_proxy 127.0.0.1:15003
	}

	@firefly host firefly.vovavolkov.com
	handle @firefly {
		reverse_proxy 127.0.0.1:15004
	}

	@fireflyimport host fireflyimport.vovavolkov.com
	handle @fireflyimport {
		reverse_proxy 127.0.0.1:15005
	}

	@readeck host readeck.vovavolkov.com
	handle @readeck {
		reverse_proxy 127.0.0.1:15006
	}

	@mealie host mealie.vovavolkov.com
	handle @mealie {
		reverse_proxy 127.0.0.1:15007
	}

	@webhook host webhook.vovavolkov.com
	handle @webhook {
		reverse_proxy 127.0.0.1:9000
	}

	@share host share.vovavolkov.com
	handle @share {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		abort
	}
}
