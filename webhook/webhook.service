# /etc/systemd/system/webhook.service
[Unit]
Description=Webhook service
After=network.target

[Service]
Type=exec
# Localhost only; reached over the tailnet through Caddy at https://webhook.vovavolkov.com
ExecStart=webhook -verbose -ip 127.0.0.1 -hooks /etc/webhook/hooks.json
Restart=on-failure
RestartSec=5

# Which user should the webhooks run as?
User=vova
Group=vova

[Install]
WantedBy=multi-user.target
