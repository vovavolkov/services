# /etc/systemd/system/webhook.service
[Unit]
Description=Webhook service
# Listens on the Tailscale address only (looked up at start). If the lookup fails
# the unit exits instead of binding to all interfaces, and Restart= retries.
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=exec
ExecStart=/bin/sh -c 'ip=$(tailscale ip -4) && [ -n "$ip" ] && exec webhook -verbose -ip "$ip" -hooks /etc/webhook/hooks.json'
Restart=on-failure
RestartSec=5

# Which user should the webhooks run as?
User=vova
Group=vova

[Install]
WantedBy=multi-user.target
