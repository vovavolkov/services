# /etc/systemd/system/webhook.service
[Unit]
Description=Webhook service
# Listens on the Tailscale address only, so wait for Tailscale to be up
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=exec
ExecStart=/bin/sh -c 'exec webhook -verbose -ip "$(tailscale ip -4)" -hooks /etc/webhook/hooks.json'
Restart=on-failure
RestartSec=5

# Which user should the webhooks run as?
User=vova
Group=vova

[Install]
WantedBy=multi-user.target
